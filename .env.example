# GEMINI_API_KEY: Required for Gemini AI API calls (Chat analyst & Research summaries).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FINNHUB_API_KEY: Optional stock market API key for live stock quotes from Finnhub.
# If not provided, StockScope AI runs smoothly in Educational Baseline mode with verified historical data.
FINNHUB_API_KEY=""

# ALPHA_VANTAGE_API_KEY: Optional alternative stock market provider key.
ALPHA_VANTAGE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
